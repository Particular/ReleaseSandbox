<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublishSingleFile Condition="'$(Configuration)' == 'Release'">true</PublishSingleFile>
        <SelfContained>true</SelfContained>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <DebugType Condition="'$(Configuration)' == 'Release'">None</DebugType>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\TotallyLegit\TotallyLegit.csproj" />
    </ItemGroup>

    <!-- Drop referenced projects' companion doc-comment files so publish output is just the exe -->
    <Target Name="RemoveDocumentationFilesFromPublishDir" AfterTargets="Publish">
        <ItemGroup>
            <_FilesToRemove Include="$(PublishDir)*.xml" />
        </ItemGroup>
        <Delete Files="@(_FilesToRemove)" />
    </Target>

</Project>
